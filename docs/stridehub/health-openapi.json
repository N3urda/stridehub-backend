{
  "openapi": "3.1.0",
  "info": {
    "title": "StrideHub 健康 API",
    "version": "1.1.0",
    "description": "保存结构化报告背景、带时间的血压测量和 Zepp 睡眠观察，供网页与 HTTP API + Skill 共用。服务端只验证数据，不诊断、不生成医学参考范围、不验证医嘱真实性，也不提供报告文件上传。健康背景请求限 1 MiB，单条血压请求限 16 KiB，睡眠同步请求限 4 KiB。所有健康响应均 no-store, private。血压和设备睡眠不会改写人工 check-in 或自动调整课表。"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/health/context": {
      "get": {
        "operationId": "getHealthContext",
        "summary": "读取当前健康背景",
        "responses": {
          "200": {
            "description": "当前背景；未保存时 version=0 且 updatedAt=null",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store, private，包括鉴权和验证错误。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthContext"
                }
              }
            }
          },
          "401": {
            "description": "缺少或无效 Bearer token",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store, private，包括鉴权和验证错误。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updateHealthContext",
        "summary": "按版本局部更新健康背景",
        "description": "必须先读取当前 version。仅允许声明的字段；顶层字段省略时保留，数组出现时整体替换。报告与引用它的约束可在同一次写入一起更改；禁止悬空引用。原子乐观锁避免覆盖另一位用户或 AI 的更新。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HealthContextPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "已保存的新版本",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store, private，包括鉴权和验证错误。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthContext"
                }
              }
            }
          },
          "401": {
            "description": "缺少或无效 Bearer token",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store, private，包括鉴权和验证错误。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "版本冲突；重新读取并比较，不可盲目重试写入",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store, private，包括鉴权和验证错误。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "请求超过 1 MiB",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store, private，包括鉴权和验证错误。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "必须为 application/json",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store, private，包括鉴权和验证错误。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "字段、引用、类型、日期或 JSON 验证失败",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store, private，包括鉴权和验证错误。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "428": {
            "description": "缺少当前 version",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store, private，包括鉴权和验证错误。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
