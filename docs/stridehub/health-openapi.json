          }
        }
      }
    },
    "/api/v1/health/blood-pressure": {
      "get": {
        "operationId": "listBloodPressure",
        "summary": "查询血压测量记录",
        "description": "按测量时间从新到旧排序，相同时间按 ID 排序。from/to 为包含边界的本地日期，from 不得晚于 to；不传日期则读取全部记录。无记录返回 records:[]。",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "description": "包含边界，按训练个人档案时区的本地日期筛选；省略时此端不限制。"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "description": "包含边界，按训练个人档案时区的本地日期筛选；省略时此端不限制。"
          }
        ],
        "responses": {
          "200": {
            "description": "符合日期范围的全部记录",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store, private，包括鉴权和验证错误。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BloodPressureList"
                }
              }
            }
          },
          "401": {
            "description": "缺少或无效 Bearer token",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store, private，包括鉴权和验证错误。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "字段、日期、类型或 JSON 验证失败",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store, private，包括鉴权和验证错误。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/blood-pressure/{id}": {
