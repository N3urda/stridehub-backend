          },
          "lifestylePreferences": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500,
              "minLength": 1,
              "pattern": ".*\\S.*"
            },
            "maxItems": 30,
            "default": []
          },
          "notes": {
            "type": "string",
            "maxLength": 10000,
            "default": ""
