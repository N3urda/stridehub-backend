    "/api/v1/health/sleep": {
      "get": {
        "operationId": "listSleepRecords",
        "summary": "查询 Zepp 睡眠日摘要",
        "description": "按归属 date、结束时间和 ID 倒序排列。from/to 按记录归属 date 比较，包含首尾；不指定则此端不限制。无记录返回 records:[]。",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "description": "记录归属日期（来源时区的醒来日期，未知时使用原始 sourceDate），from 不得晚于 to。"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "description": "记录归属日期（来源时区的醒来日期，未知时使用原始 sourceDate），from 不得晚于 to。"
          }
        ],
        "responses": {
          "200": {
            "description": "日期范围内已保存的设备睡眠",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store, private，包括鉴权和验证错误。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SleepList"
                }
              }
            }
          },
          "401": {
            "description": "缺少或无效 StrideHub Bearer token；不同于 Zepp 登录过期",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store, private，包括鉴权和验证错误。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "字段、日期、类型或 JSON 验证失败",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store, private，包括鉴权和验证错误。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/sleep/status": {
      "get": {
        "operationId": "getSleepSyncStatus",
        "summary": "读取 Zepp 睡眠同步状态",
        "description": "读取状态不访问 Zepp，也不触发同步。凭据和账号标识不出现在响应中。",
        "responses": {
          "200": {
            "description": "当前配置和最近同步状态",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store, private，包括鉴权和验证错误。"
              }
            },
