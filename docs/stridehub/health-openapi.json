          "notes",
          "id",
          "version",
          "updatedAt"
        ]
      },
      "HealthContextPatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Report"
            },
