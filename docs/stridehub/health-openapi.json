                  "type": "string"
                },
                "description": "no-store, private，包括鉴权和验证错误。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/sleep/sync": {
      "post": {
        "operationId": "syncZeppSleep",
        "summary": "从已授权 Zepp 账号同步近期睡眠",
        "description": "凭据来自服务端私有文件；请求不得提供密码或令牌。按来源账号和 sourceDate 幂等更新，内容未变不增加版本；不覆盖人工 check-in 或自动修改课表。更换账号会拒绝同步，避免混入其他人的记录。同步请求限 4 KiB；最多同步 90 个近期日历日。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SleepSyncRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "已完成成功或空数据同步；查看 state 与计数",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store, private，包括鉴权和验证错误。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SleepSyncStatus"
                }
              }
            }
          },
          "401": {
            "description": "缺少或无效 StrideHub Bearer token；不同于 Zepp 登录过期",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store, private，包括鉴权和验证错误。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "已有睡眠同步正在执行，读取状态后稍后重试",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store, private，包括鉴权和验证错误。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "同步请求超过 4 KiB",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store, private，包括鉴权和验证错误。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "必须使用 application/json",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store, private，包括鉴权和验证错误。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "字段、日期、类型或 JSON 验证失败",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store, private，包括鉴权和验证错误。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Zepp 未配置、授权过期或同步失败；返回 SleepSyncStatus，保留历史记录。此处 auth_required 是 Zepp 授权问题，不表示 StrideHub Bearer 失效。",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store, private，包括鉴权和验证错误。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SleepSyncStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用服务端 DREEVE_API_KEY；仅通过 Authorization 头传递。"
      }
    },
    "schemas": {
      "Finding": {
