          },
          "flag": {
            "type": "string",
            "enum": [
              "normal",
              "high",
              "low",
              "abnormal",
              "unknown"
            ],
            "default": "unknown"
          },
          "page": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 10000,
            "default": null
          }
        },
        "required": [
          "name",
          "valueText"
        ]
      },
      "Report": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$",
            "maxLength": 80
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "reportDate": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "sourceLabel": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "pattern": ".*\\S.*",
            "description": "可追溯的报告来源标签，如文件名和机构；不接受文件上传。"
          },
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "maxItems": 200,
            "default": []
          },
          "clinicianAdvice": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2000,
              "minLength": 1,
              "pattern": ".*\\S.*"
            },
            "maxItems": 30,
            "default": []
          },
          "aiInterpretation": {
            "type": "string",
            "maxLength": 10000,
            "default": "",
            "description": "独立保存 AI 解读，与原始结果、医生原文分开；不是后端生成或认证的诊断。"
          },
          "needsReview": {
            "type": "boolean",
            "default": true,
            "description": "调用方声明是否仍需核对原报告；false 不代表后端完成医学验证。"
          },
          "notes": {
            "type": "string",
            "maxLength": 4000,
            "default": ""
          }
        },
        "required": [
          "id",
          "title",
          "reportDate",
          "sourceLabel"
        ]
      },
      "Constraint": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$",
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "sourceType": {
            "type": "string",
            "enum": [
              "clinician",
              "user"
            ],
            "description": "调用方声明的来源：clinician 为转录医嘱，user 为用户约束。系统不核验医学真实性。不得把 AI 推断写成医嘱。"
          },
          "sourceReportId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,80}$",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "非空时必须指向本次保存后仍存在的 reports.id。"
          },
          "validFrom": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "reviewOn": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "复核日期，不得早于非空 validFrom；不会到期自动解除限制。"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ],
            "default": "active"
          }
        },
        "required": [
          "id",
          "description",
          "sourceType"
        ]
      },
      "HealthContext": {
