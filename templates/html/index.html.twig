{% extends 'html/stridehub/shell.html.twig' %}
{% set activeNav = 'movement' %}
{% set showLogout = false %}
{% set workspaceLabel = '运动档案视图' %}
{% set pageKicker = 'ACTIVITY ARCHIVE · 原始运动详情' %}
{% set showPageHeading = false %}
{% block title %}运动档案 · StrideHub{% endblock %}
{% block body_class %}hub-activity-archive{% endblock %}
{% block head_meta %}
    <meta name="js-dist-url" content="{{ relativeUrl('js/dist/')|e('html_attr') }}">
    <meta name="js-dist-version" content="{{ assetVersion()|e('html_attr') }}">
    <meta name="apple-mobile-web-app-title" content="StrideHub">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ relativeUrl('assets/images/manifest/icon-apple-180.maskable.png')|e('html_attr') }}">
    <link href="{{ relativeUrl('manifest.json')|e('html_attr') }}" rel="manifest" crossorigin="use-credentials">
{% endblock %}
{% block base_stylesheets %}
    <link href="{{ relativeUrl(asset('css/dist/tailwind.min.css'))|e('html_attr') }}" rel="stylesheet">
    <link rel="preload" href="{{ relativeUrl(asset('libraries/leaflet/leaflet.min.css'))|e('html_attr') }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <link rel="preload" href="{{ relativeUrl(asset('libraries/leaflet/leaflet-gesture-handling.min.css'))|e('html_attr') }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <link rel="preload" href="{{ relativeUrl(asset('libraries/clusterize/clusterize.min.css'))|e('html_attr') }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <link rel="preload" href="{{ relativeUrl(asset('libraries/lightgallery/lightgallery-bundle.min.css'))|e('html_attr') }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
{% endblock %}
{% block page_content %}
    <div class="hub-archive-intro"><a href="{{ relativeUrl('/admin/running')|e('html_attr') }}">← 返回运动总览</a><span>运动原始档案</span></div>
    <details class="hub-archive-tools"><summary>更多运动视图</summary><nav class="hub-admin-links" aria-label="运动档案视图">
        {% for item in [
            {url:'activities',label:'全部运动'}, {url:'heatmap',label:'运动地图'},
            {url:'best-efforts',label:'最佳表现'}, {url:'milestones',label:'里程碑'},
            {url:'rewind',label:'年度回顾'},
            {url:'gear',label:'装备档案'}, {url:'dashboard',label:'更多统计'}
        ] %}<a href="{{ relativeUrl(item.url)|e('html_attr') }}" data-router-link>{{ item.label }}</a>{% endfor %}
    </nav></details>
    {# Retained for the existing fragment application's theme event binding. #}
    <span class="dark-mode-toggle" hidden><input type="checkbox" tabindex="-1" aria-label="归档图表主题"></span>
    {% block main %}
        <div id="spinner" class="items-center justify-center h-auto min-h-screen hidden">{% include 'html/loader.html.twig' with {modifier: 'loader--md'} %}</div>
        <div id="js-loaded-content"></div>
    {% endblock %}
{% endblock %}
{% block scripts %}
    <script>
        window.dreeve = {{ javascriptWindowConstants|raw }};
        window.dreeve.placeholderBrokenImage = "{{ relativeUrl('/assets/placeholder-broken.webp')|e('js') }}";
    </script>
    <script src="{{ relativeUrl(asset('libraries/echarts/echarts.min.js'))|e('html_attr') }}" defer></script>
    <script src="{{ relativeUrl(asset('libraries/echarts/echarts.world.min.js'))|e('html_attr') }}" defer></script>
    <script src="{{ relativeUrl(asset('js/dist/app.min.js'))|e('html_attr') }}" type="module"></script>
    {% block customScripts %}{% endblock %}
{% endblock %}
