{% extends 'html/stridehub/shell.html.twig' %}
{% set activeNav = 'settings' %}
{% set pageKicker = 'ADVANCED · DATA CONNECTIONS' %}
{% set showPageHeading = false %}
{% set showLogout = false %}
{% set workspaceLabel = '数据连接' %}
{% block title %}Strava 数据连接 · StrideHub{% endblock %}
{% block base_stylesheets %}<link href="{{ relativeUrl(asset('css/dist/tailwind.min.css')) }}" rel="stylesheet">{% endblock %}
{% block page_content %}
{% autoescape false %}
<nav class="hub-admin-return" aria-label="返回总览"><a href="{{ relativeUrl('/admin/insights') }}">← 返回总览</a></nav>
<section class="hub-legacy-setup flex flex-col justify-center px-0 py-8">
    <div class="mx-auto w-full max-w-xl p-6 bg-white border border-gray-200 rounded-lg shadow-xs">
        <h2 class="text-2xl font-bold tracking-tight">Strava authorization is not needed here</h2>
        <p class="mt-1 text-sm text-gray-500">
            You are running {{ appName }} with <code class="font-mono text-xs text-gray-700">IMPORT_MODE=files</code>. In this mode activities are imported from the files you upload, so there is no need to connect a Strava account.
        </p>
        <p class="mt-4 text-sm text-gray-500">
            Want to import straight from Strava instead? Switch to <code class="font-mono text-xs text-gray-700">IMPORT_MODE=stravaApi</code> and restart your container. See <a class="font-medium text-primary hover:underline" href="https://docs.dreeve.app/getting-started/installation/#env">the docs</a> for the details.
        </p>
        <a href="{{ relativeUrl('/') }}"
           class="mt-6 inline-flex w-full items-center justify-center gap-2.5 rounded-xl bg-primary px-5 py-3 font-semibold text-white shadow-sm transition hover:brightness-95">
            Back to the app
        </a>
    </div>
</section>
{% endautoescape %}
{% endblock %}
