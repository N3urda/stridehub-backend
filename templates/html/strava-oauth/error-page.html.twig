{% extends 'html/stridehub/shell.html.twig' %}
{% set activeNav = 'settings' %}
{% set pageKicker = 'ADVANCED · DATA CONNECTIONS' %}
{% set showPageHeading = false %}
{% set showLogout = false %}
{% set workspaceLabel = '数据连接' %}
{% block title %}Strava 数据连接 · StrideHub{% endblock %}
{% block base_stylesheets %}<link href="{{ relativeUrl(asset('css/dist/tailwind.min.css')) }}" rel="stylesheet">{% endblock %}
{% block page_content %}
{% autoescape false %}
<nav class="hub-admin-return" aria-label="返回总览"><a href="{{ relativeUrl('/admin/insights') }}">← 返回总览</a></nav>
<section class="hub-legacy-setup flex flex-col justify-center px-0 py-8">
    <div class="mx-auto w-full max-w-xl p-6 bg-white border border-gray-200 rounded-lg shadow-xs">
        <h2 class="text-2xl font-bold tracking-tight">Hmmm, something went wrong</h2>
        <p class="mt-1 text-sm text-gray-500">We hit a snag while talking to Strava. The details are below.</p>
        <div class="mt-6 overflow-hidden rounded-xl border border-red-200 bg-red-50">
            <div class="border-b border-red-200 bg-red-100/60 px-4 py-2 text-xs font-semibold uppercase tracking-wide text-red-700">Error details</div>
            <p class="px-4 py-3 font-mono text-sm text-red-800">{{ error }}</p>
        </div>
        <p class="mt-4 text-sm text-gray-500">
            Please check the <a class="font-medium text-primary hover:underline" href="https://docs.dreeve.app/troubleshooting/strava-api-errors/">troubleshooting guide</a> for help resolving this.
        </p>
    </div>
</section>
{% endautoescape %}
{% endblock %}
