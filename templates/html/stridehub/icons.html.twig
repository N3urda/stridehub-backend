{% macro icon(name, className = '') %}
<svg class="hub-icon {{ className|e('html_attr') }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{% if name == 'overview' %}<rect x="3.5" y="3.5" width="6" height="6" rx="1.7"/><rect x="14.5" y="3.5" width="6" height="6" rx="1.7"/><rect x="3.5" y="14.5" width="6" height="6" rx="1.7"/><path d="M14.5 19.5v-3m3 3v-6m3 6v-9"/>
{% elseif name == 'body' %}<path d="M12 20s-8-4.8-8-10.3a4.2 4.2 0 0 1 8-1.8 4.2 4.2 0 0 1 8 1.8C20 15.2 12 20 12 20Z"/><path d="M3 12h5l2-3 3 6 2-3h6"/>
{% elseif name == 'movement' %}<circle cx="15.5" cy="4.5" r="1.8"/><path d="m11.5 7.5 3 3 4 .5m-7-3-3 4 4 3-1 6m.5-7 3.5 3.5 4 2M5 8h3M3 12h3M2 16h4"/>
{% elseif name == 'plans' %}<rect x="4" y="5" width="16" height="16" rx="3"/><path d="M8 3v4m8-4v4M4 10h16m-12 5 2.5 2.5 5-5"/>
{% elseif name == 'sleep' %}<path d="M19.5 14.5A8.5 8.5 0 0 1 9.5 4.1a8.5 8.5 0 1 0 10 10.4Z"/><path d="M16.5 3.5v4m-2-2h4M21 9v2m-1-1h2"/>
{% elseif name == 'weight' %}<rect x="4" y="3" width="16" height="18" rx="4"/><path d="M8 7a7 7 0 0 1 8 0l-2 4h-4L8 7Zm4 1v3"/>
{% elseif name == 'pressure' %}<path d="M12 3c-2 4-7 7.6-7 12a7 7 0 0 0 14 0c0-4.4-5-8-7-12Z"/><path d="M8 15h2l1-3 2 6 1-3h2"/>
{% elseif name == 'settings' %}<path d="M4 7h16M4 17h16"/><rect x="7" y="4" width="4" height="6" rx="1.5" fill="currentColor" stroke="none"/><rect x="14" y="14" width="4" height="6" rx="1.5" fill="currentColor" stroke="none"/>
{% elseif name == 'upload' %}<path d="M12 16V3m-4 4 4-4 4 4M4 14v5a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5"/>
{% elseif name == 'arrow' %}<path d="M5 12h14m-5-5 5 5-5 5"/>
{% elseif name == 'logout' %}<path d="M9 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h3m6-13 5 5-5 5m-7-5h12"/>
{% elseif name == 'check' %}<path d="m5 12 4 4L19 6"/>
{% elseif name == 'spark' %}<path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3Z"/>
{% else %}<circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/>{% endif %}
</svg>
{% endmacro %}

{% macro mark() %}
<svg viewBox="0 0 40 40" fill="none" aria-hidden="true"><rect width="40" height="40" rx="13" fill="currentColor"/><path d="M12 26.5 18 12h5l-3.5 8h8L22 29" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><circle cx="28.5" cy="11.5" r="2" fill="#A8B6FF"/></svg>
{% endmacro %}
