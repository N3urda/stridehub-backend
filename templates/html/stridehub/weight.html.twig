{% extends 'html/stridehub/shell.html.twig' %}
{% set activeNav = 'weight' %}{% set showPageHeading = false %}
{% block title %}减重数据 · StrideHub{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ relativeUrl(asset('css/stridehub-insights.css')) }}"><link rel="stylesheet" href="{{ relativeUrl(asset('css/stridehub-workspace.css')) }}">{% endblock %}
{% block head_scripts %}<script defer src="{{ relativeUrl(asset('js/stridehub-data.js')) }}"></script><script defer src="{{ relativeUrl(asset('js/stridehub-workspace.js')) }}"></script>{% endblock %}
{% block page_content %}
<div id="data-workspace" class="hub-records data-workspace" data-view="weight" data-base="{{ relativeUrl('/admin/health/api') }}" data-csrf="{{ csrf_token('health')|e('html_attr') }}">
    <header class="insights-heading"><div><p class="soft-label">WEIGHT / 减重</p><h1>目标与体重变化</h1><p class="subtle">实测体重、七日均值与阶段目标，分别保留。</p></div><button id="data-refresh" class="hub-button" type="button">刷新数据</button></header>
    {% include 'html/stridehub/workspace-toolbar.html.twig' %}
    <section class="hub-surface"><div class="section-title"><h2>体重概览</h2><a class="text-link" href="{{ relativeUrl('/admin/health#body-weight') }}">记录体重</a></div><div id="weight-data-metrics" class="compact-metrics"></div><div id="weight-data-chart" class="data-chart"></div><p class="subtle small">七日均值只使用对应日期及前六天的实测值，并显示样本天数；目标点是计划值。</p></section>
    <div class="data-two-columns"><section class="hub-surface"><h2>减重目标</h2><div id="weight-goals"></div></section>
    <section class="hub-surface"><h2 id="goal-form-title">设置目标</h2><form id="goal-form" class="data-form">
        <label class="wide">目标名称<input name="title" required maxlength="200" placeholder="填写你的目标"></label><label>开始日期<input name="startDate" type="date" required></label><label>结束日期<input name="endDate" type="date" required></label>
        <label>起始体重 kg<input name="startWeightKg" type="number" min="0.1" max="1000" step="0.01" required></label><label>目标体重 kg<input name="targetWeightKg" type="number" min="0.1" max="1000" step="0.01" required></label>
        <label>状态<select name="status"><option value="active">进行中</option><option value="draft">草稿</option><option value="paused">暂停</option><option value="completed">已完成</option><option value="cancelled">已取消</option></select></label>
        <label class="wide">备注<input name="notes" maxlength="2000"></label><div class="data-actions wide"><button class="hub-button primary" type="submit">保存目标</button><button class="hub-button" type="button" id="goal-reset">新建目标</button></div><p id="goal-status" class="data-message wide" role="status"></p>
    </form><details><summary>修改记录</summary><div id="record-history" class="data-history"></div></details></section></div>
    <section class="hub-surface"><h2>体重记录与趋势均值</h2><div id="weight-data-table" class="data-table-scroll"></div></section>
    <div class="data-two-columns"><section class="hub-surface"><h2>腰围与体脂记录</h2><div id="measurements-table" class="data-table-scroll"></div></section>
    <section class="hub-surface"><h2>记录身体测量</h2><form id="measurement-form" class="data-form"><label>日期<input name="date" type="date" required></label><label>腰围 cm<input name="waistCm" type="number" min="1" max="400" step="0.1"></label><label>体脂率 %<input name="bodyFatPercent" type="number" min="0" max="100" step="0.1"></label><label>来源<input name="sourceLabel" maxlength="200" placeholder="例如：家用体脂秤"></label><label class="wide">备注<input name="notes" maxlength="2000"></label><div class="data-actions wide"><button class="hub-button primary" type="submit">保存测量</button><button class="hub-button" id="measurement-reset" type="button">新建测量</button></div><p id="measurement-status" class="data-message wide" role="status"></p></form></section></div>
</div>
{% endblock %}
