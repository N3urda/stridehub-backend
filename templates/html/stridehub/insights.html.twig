{% extends 'html/stridehub/shell.html.twig' %}
{% set activeNav = 'overview' %}
{% set showPageHeading = false %}
{% block title %}我的健康总览 · StrideHub{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ relativeUrl(asset('css/stridehub-insights.css')) }}">{% endblock %}
{% block head_scripts %}<script defer src="{{ relativeUrl(asset('js/stridehub-data.js')) }}"></script><script defer src="{{ relativeUrl(asset('js/stridehub-insights.js')) }}"></script>{% endblock %}
{% block page_content %}
<div id="insights-app" class="insights" data-base="{{ relativeUrl('/admin') }}" data-csrf="{{ csrf_token('health')|e('html_attr') }}">
    <header class="insights-heading"><div><p id="overview-date" class="soft-label">我的健康记录</p><h1>每天的你，都有迹可循。</h1><p class="subtle">让身体留下记录，让下一步有据可依。</p></div><button class="hub-button" id="overview-refresh" type="button">刷新数据</button></header>
    <div id="overview-status" role="status" aria-live="polite" class="hub-notice" hidden></div>
    <div class="overview-toolbar"><div class="period-switch" aria-label="查看周期"><button type="button" data-days="7">7 天</button><button type="button" data-days="30" aria-pressed="true" class="selected">30 天</button><button type="button" data-days="90">90 天</button></div><a href="#sync-description" id="sync-top-status" class="sync-status-chip">正在检查同步状态</a><span class="subtle" id="overview-range">正在读取你的记录…</span></div>
    <div class="insights-grid">
        <section class="sleep-feature" aria-labelledby="sleep-feature-title"><div class="feature-heading"><div class="feature-label"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M22 4a12 12 0 1 0 6 19A12 12 0 0 1 22 4Z"/><path d="m10 4 1 2 2 1-2 1-1 2-1-2-2-1 2-1Z"/></svg><h2 id="sleep-feature-title">睡眠，是一天的起点。</h2></div><a href="{{ relativeUrl('/admin/health#sleep-section') }}">睡眠记录</a></div>
            <div class="sleep-hero"><div><p class="sleep-date" id="latest-sleep-date">正在读取睡眠</p><div id="latest-sleep-duration" class="sleep-duration">—<span>小时</span> —<span>分</span></div><p class="sleep-window" id="latest-sleep-window">入睡与醒来时间将显示在这里</p></div><div class="moon-orbit" aria-hidden="true"><svg viewBox="0 0 200 190"><defs><linearGradient id="moon-shade" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#d3d5ff"/><stop offset="1" stop-color="#8794ed"/></linearGradient></defs><ellipse cx="101" cy="102" rx="88" ry="58" fill="none" stroke="#7888bb" stroke-opacity=".3" transform="rotate(-25 101 102)"/><ellipse cx="101" cy="102" rx="79" ry="76" fill="none" stroke="#7888bb" stroke-opacity=".2"/><path d="M118 38a64 64 0 1 0 42 99A62 62 0 0 1 118 38Z" fill="url(#moon-shade)"/><circle cx="43" cy="54" r="3" fill="#fff"/><circle cx="163" cy="64" r="2" fill="#fff"/><path d="M154 23v13m-6-6h12M49 143v9m-4-4h8" stroke="#dbe5ff" stroke-width="2" stroke-linecap="round"/></svg></div></div>
            <div id="sleep-stage-bar" class="stage-bar" aria-label="睡眠阶段时长构成"></div><div id="sleep-stage-legend" class="stage-legend"></div><p class="chart-caption" id="sleep-stage-caption">按阶段累计时长展示，不代表阶段发生顺序。</p>
            <div class="sleep-trend-heading"><span>睡眠时长</span><span id="sleep-average">等待记录</span></div><div id="overview-sleep-chart" class="mini-chart" aria-label="睡眠时长趋势"></div>
        </section>
        <section class="plan-preview hub-surface" aria-labelledby="today-plan-title"><div class="section-title"><div class="title-icon blue"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v16H4zM8 2v6m8-6v6M4 11h16m-12 4h3m3 0h2m-8 3h3"/></svg></div><h2 id="today-plan-title">接下来，按自己的节奏。</h2></div><p class="subtle">课表和生活计划，汇集在这里。</p><div id="overview-plans" class="plan-preview-list"><p class="empty-note">正在读取已保存的安排…</p></div><a class="hub-button full-button" href="{{ relativeUrl('/admin/plans') }}">查看我的计划</a><div class="ai-note"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5Z"/></svg><p>把记录交给 AI，一起安排下一步。已下发的计划会保存在这里。</p></div></section>
        <section class="metric-surface hub-surface" aria-labelledby="movement-title"><div class="section-title"><div class="title-icon mint"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 17 4-5 3 3 6-10m-5 0h5v5M3 21h18"/></svg></div><h2 id="movement-title">日常活动</h2><span id="activity-source" class="metric-source">Zepp</span></div><div id="activity-metrics" class="compact-metrics"></div><div id="steps-chart" class="mini-chart" aria-label="每日步数趋势"></div><p id="activity-caption" class="subtle small">步数与跑步训练分别记录。</p></section>
        <section class="metric-surface hub-surface" aria-labelledby="vitals-title"><div class="section-title"><div class="title-icon coral"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 5c-3-3-6-1-8 1-2-2-5-4-8-1-4 5 2 10 8 15 6-5 12-10 8-15Z"/><path d="M3 11h4l2-4 4 9 2-5h6"/></svg></div><h2 id="vitals-title">身体信号</h2></div><div id="vital-metrics" class="compact-metrics"></div><p id="vitals-caption" class="subtle small">每项指标都保留测量日期。</p><a class="text-link" href="{{ relativeUrl('/admin/health') }}">查看身体记录</a></section>
        <section class="movement-surface hub-surface"><div class="section-title"><div><h2>每一次运动，都算数。</h2><p class="subtle" id="running-caption">这段时间的跑步积累</p></div><a class="text-link" href="{{ relativeUrl('/admin/running') }}">全部运动</a></div><div id="running-metrics" class="compact-metrics"></div><div id="recent-activities" class="recent-activities"></div></section>
        <section class="data-surface hub-surface"><div class="section-title"><h2>数据正在积累</h2><span id="data-day-count" class="source-pill">Zepp</span></div><p class="subtle">保存原始记录，为每次回顾多留一份依据。</p><div id="data-coverage" class="coverage-list"></div><p id="sync-description" class="subtle small">正在读取连接状态…</p><button id="overview-sync" class="hub-button" type="button">同步 Zepp 数据</button><details class="data-details"><summary>查看各项数据来源</summary><div id="sync-sources"></div></details><details class="data-details"><summary>AI 可以读到什么？</summary><p>睡眠、日常活动、运动明细、血压和体重，以及你的已保存计划。设备未提供的数据会标为缺失；原始 Zepp 记录也会保留供后续分析。</p><a href="{{ relativeUrl('/admin/plans#ai-handoff') }}">查看 AI 协作方式</a></details></section>
    </div>
    <noscript><p class="hub-notice">请开启 JavaScript 以读取你的健康记录。</p></noscript>
</div>
{% endblock %}
