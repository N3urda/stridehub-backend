{% extends 'html/stridehub/shell.html.twig' %}
{% set activeNav = 'nutrition' %}{% set showPageHeading = false %}
{% block title %}饮食数据 · StrideHub{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ relativeUrl(asset('css/stridehub-insights.css')) }}"><link rel="stylesheet" href="{{ relativeUrl(asset('css/stridehub-workspace.css')) }}">{% endblock %}
{% block head_scripts %}<script defer src="{{ relativeUrl(asset('js/stridehub-data.js')) }}"></script><script defer src="{{ relativeUrl(asset('js/stridehub-workspace.js')) }}"></script>{% endblock %}
{% block page_content %}
<div id="data-workspace" class="hub-records data-workspace" data-view="nutrition" data-base="{{ relativeUrl('/admin/health/api') }}" data-csrf="{{ csrf_token('health')|e('html_attr') }}">
    <header class="insights-heading"><div><p class="soft-label">NUTRITION / 饮食</p><h1>饮食计划与实际摄入</h1><p class="subtle">按餐记录食物与份量，对照每天的营养目标。</p></div><button id="data-refresh" class="hub-button" type="button">刷新数据</button></header>
    {% include 'html/stridehub/workspace-toolbar.html.twig' %}
    <section class="hub-surface"><div class="section-title"><h2>所选日期 · 营养对比</h2><label class="data-date-label">日期<input type="date" id="nutrition-date"></label></div><div id="nutrition-metrics" class="compact-metrics"></div><p class="subtle small">实际值仅统计已记录的餐次。营养值缺失时显示 —，不代表零摄入或全天已记录完整。</p></section>
    <section class="hub-surface"><div class="section-title"><h2>能量记录趋势</h2><span class="source-pill">目标 / 已记录 · kcal</span></div><div id="nutrition-chart" class="data-chart"></div></section>
    <div class="data-two-columns">
        <section class="hub-surface"><div class="section-title"><h2>当日饮食计划</h2></div><div id="nutrition-plan"></div></section>
        <section class="hub-surface"><div class="section-title"><h2 id="meal-form-title">记录一餐</h2></div>
            <form id="meal-form" class="data-form">
                <label>日期<input name="date" type="date" required></label><label>餐次<select name="mealType"><option value="breakfast">早餐</option><option value="lunch">午餐</option><option value="dinner">晚餐</option><option value="snack">加餐</option><option value="fuel">运动补给</option><option value="other">其他</option></select></label>
                <label class="wide">食物<input name="foods" required maxlength="2000" placeholder="例如：米饭、鸡肉、蔬菜"></label><label class="wide">份量<input name="portion" maxlength="500" placeholder="例如：米饭一碗，鸡肉 150 g"></label>
                <label>能量 kcal<input name="energyKcal" type="number" min="0" max="30000" step="0.1"></label><label>蛋白质 g<input name="proteinGrams" type="number" min="0" max="5000" step="0.1"></label><label>碳水 g<input name="carbohydrateGrams" type="number" min="0" max="5000" step="0.1"></label><label>脂肪 g<input name="fatGrams" type="number" min="0" max="5000" step="0.1"></label>
                <label>营养数值来源<select name="nutritionSource"><option value="unknown">未填写</option><option value="label">食品标签</option><option value="database">食物数据库</option><option value="estimate">估算</option></select></label><label>来源说明<input name="sourceLabel" maxlength="200" placeholder="可选"></label>
                <label class="wide">备注<input name="notes" maxlength="2000"></label><div class="data-actions wide"><button type="submit" class="hub-button primary">保存记录</button><button type="button" id="meal-reset" class="hub-button">新建一餐</button></div>
                <p id="meal-status" class="data-message wide" role="status"></p>
            </form>
        </section>
    </div>
    <section class="hub-surface"><div class="section-title"><h2>实际饮食明细</h2><span id="meal-count" class="source-pill"></span></div><div id="meals-table" class="data-table-scroll"></div><details><summary>修改记录</summary><div id="record-history" class="data-history"></div></details></section>
    <section class="hub-surface"><h2>逐日目标与记录</h2><div id="nutrition-days" class="data-table-scroll"></div></section>
</div>
{% endblock %}
