{% extends 'html/stridehub/shell.html.twig' %}
{% import 'html/stridehub/icons.html.twig' as icons %}
{% set activeNav = 'body' %}
{% set pageKicker = 'BODY & RECOVERY' %}
{% set showPageHeading = false %}
{% block title %}身体记录 · StrideHub{% endblock %}
{% block body_class %}{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ relativeUrl(asset('css/stridehub-training.css'))|e('html_attr') }}">
    <link rel="stylesheet" href="{{ relativeUrl(asset('css/stridehub-health.css'))|e('html_attr') }}">
    <link rel="stylesheet" href="{{ relativeUrl(asset('css/stridehub-insights.css'))|e('html_attr') }}">
    <link rel="stylesheet" href="{{ relativeUrl(asset('css/stridehub-composition.css'))|e('html_attr') }}">
{% endblock %}
{% block head_scripts %}
    <script defer src="{{ relativeUrl(asset('js/stridehub-mi-fitness.js'))|e('html_attr') }}"></script>
    <script defer src="{{ relativeUrl(asset('js/stridehub-health.js'))|e('html_attr') }}"></script>
    <script defer src="{{ relativeUrl(asset('js/stridehub-data.js'))|e('html_attr') }}"></script>
    <script defer src="{{ relativeUrl(asset('js/stridehub-composition.js'))|e('html_attr') }}"></script>
<script defer src="{{ relativeUrl(asset('js/stridehub-body.js'))|e('html_attr') }}"></script>
<script defer src="{{ relativeUrl(asset('js/stridehub-collection.js'))|e('html_attr') }}"></script>
    <script defer src="{{ relativeUrl(asset('js/stridehub-health-context.js'))|e('html_attr') }}"></script>
{% endblock %}
{% block page_content %}
<div id="health-app" data-api-base="{{ relativeUrl('/admin/health/api')|e('html_attr') }}" data-profile-url="{{ relativeUrl('/admin/training/api/profile')|e('html_attr') }}" data-csrf="{{ csrf_token('health')|e('html_attr') }}">
<div id="health-main" class="health-shell">
        <div class="health-heading"><div><h1>身体与恢复</h1><p class="muted">睡眠分期、活动分布与测量趋势。</p></div><button type="button" id="health-refresh" class="button">刷新记录</button></div>
        <nav class="health-jump" aria-label="健康记录导航"><a href="#sleep-section">睡眠记录</a><a href="#body-weight">体重趋势</a><a href="#collection-history">逐次采集</a><a href="#zepp-sources">手表来源</a><a href="#collection-devices">手机与设置</a><a href="#pressure-section">血压记录</a><a href="#health-context-section">报告与健康背景</a></nav>
        <div id="health-status" class="notice" role="status" aria-live="polite" hidden></div>
        <noscript><p class="notice error">请开启 JavaScript 以读取和保存健康记录。</p></noscript>
        <form id="health-range" class="health-range"><div class="health-range-shortcuts" role="group" aria-label="快捷日期范围"><button type="button" class="button small" data-health-days="7" aria-pressed="false">最近 7 天</button><button type="button" class="button small" data-health-days="30" aria-pressed="false">最近 30 天</button><button type="button" class="button small" data-health-days="90" aria-pressed="true">最近 90 天</button></div><label>开始日期<input type="date" name="from" required></label><label>结束日期<input type="date" name="to" required></label><button class="button" type="submit">查看这段时间</button><p id="health-applied-range" class="muted" role="status" aria-live="polite"></p><p id="health-timezone" class="muted"></p></form>
        <section id="sleep-section" class="health-panel sleep-panel" aria-labelledby="sleep-title">
            <div class="health-section-heading"><div><div class="hub-section-title"><span class="hub-section-icon">{{ icons.icon('sleep') }}</span><h2 id="sleep-title">睡眠 · 多来源互补</h2></div><p class="muted">小米与 Zepp 按记录完整度互补，同一段睡眠只统计一次；原始来源和小睡分别保留。</p></div><button type="button" id="sleep-sync" class="button" disabled>同步 Zepp（90 天）</button></div>
            <div class="form-actions"><button type="button" id="mi-fitness-connect" class="button primary" aria-controls="mi-fitness-pair" aria-expanded="false">连接小米运动健康</button><button type="button" id="mi-fitness-sync" class="button" disabled>同步小米数据（7 天）</button><button type="button" id="mi-fitness-refresh" class="button">刷新小米状态</button></div>
            <p id="mi-fitness-status" role="status" aria-live="polite">正在读取小米连接状态…</p>
            <section id="mi-fitness-pair" class="mi-fitness-pair" aria-labelledby="mi-fitness-pair-title" hidden>
                <h3 id="mi-fitness-pair-title">扫码连接小米运动健康</h3>
                <p>用本人的小米账号或米家 App 扫码，并在手机上确认授权。绑定后可同步最近 7 天数据。</p>
                <img id="mi-fitness-pair-qr" class="mi-fitness-pair-qr" width="240" height="240" alt="小米账号绑定二维码" referrerpolicy="no-referrer" hidden>
                <p id="mi-fitness-pair-status" role="status" aria-live="polite"></p>
                <p id="mi-fitness-pair-expiry" class="muted"></p>
                <div class="form-actions"><button type="button" id="mi-fitness-pair-cancel" class="button" hidden>取消绑定</button><button type="button" id="mi-fitness-pair-retry" class="button" hidden>重新获取二维码</button><button type="button" id="mi-fitness-pair-close" class="button" hidden>收起</button></div>
            </section>
            <details class="health-history"><summary>所有来源与小睡（不重复计入趋势）</summary><div id="sleep-source-records"></div></details>
            <div id="sleep-status" role="status" class="form-status" aria-live="polite">正在读取同步状态…</div>
            <p id="sleep-sync-result" class="health-sync-result" hidden></p>
            <div id="sleep-sync-notice" class="form-status" role="status" aria-live="polite" hidden></div>
            <button type="button" id="sleep-sync-refresh" class="button small" hidden>刷新同步状态</button>
            <div id="sleep-history-status"><div id="sleep-record-status" role="status" class="form-status" aria-live="polite" hidden></div></div>
            <p id="sleep-range" class="health-data-range" role="status" aria-live="polite">尚未载入睡眠记录。</p>
            <div id="sleep-summary" class="health-metrics"></div>
            <div id="sleep-chart" class="health-chart" aria-label="睡眠时长趋势"></div>
            <details class="health-history"><summary>每晚睡眠记录</summary><div id="sleep-records"><p class="muted">正在读取…</p></div></details>
            <details class="health-help"><summary>没有看到睡眠数据？</summary><p>先在手机 Zepp App 中完成手表同步，再点击“立即同步”。未记录的睡眠阶段会显示“未知”，不会填成 0。</p><p id="sleep-setup">正在检查连接状态。</p><p>睡眠记录与手填的每日身体状态分别保存。同步不会覆盖你的睡眠体感、疲劳或疼痛反馈。</p></details>
            <p class="health-footnote">睡眠阶段来自设备估计，缺失记录不代表没有睡眠。</p>
        </section>
        <section class="health-panel" aria-labelledby="mi-data-title">
            <h2 id="mi-data-title">小米手环与手机 · 数据明细</h2>
            <p class="muted">随上方日期范围展示。各来源独立保留；暂无数据不代表设备不支持，先在手机 App 完成同步。</p>
            <div id="mi-data-summary" role="status" aria-live="polite">正在读取…</div>
            <details class="health-history"><summary>每日活动汇总</summary><div id="mi-data-daily"></div></details>
            <label>查看数据类型<select id="mi-data-type">
                <option value="steps">步数与距离</option><option value="calories">活动消耗</option>
                <option value="heart_rate">心率</option><option value="resting_heart_rate">静息心率</option>
                <option value="spo2">血氧</option><option value="stress">压力</option>
                <option value="weight">体重与体成分</option><option value="abnormal_heart_beat">异常心搏事件</option>
                <option value="workouts">运动记录</option>
            </select></label>
            <p id="mi-data-record-status" role="status" aria-live="polite"></p>
            <div id="mi-data-records"></div><button type="button" id="mi-data-more" class="button" hidden>加载更多</button>
            <p class="health-footnote">仅展示设备实际返回的字段。未确认含义的字段保留原值；小米活动与 Zepp 分别展示，不直接相加。体重及运动来源记录暂不自动关联手填记录或训练计划。</p>
        </section>
        {% include 'html/stridehub/body-composition.html.twig' %}
        {% include 'html/stridehub/body-extra.html.twig' %}
        <section id="health-context-section" class="health-panel" aria-labelledby="health-context-title">
            <p><a class="button" href="{{ relativeUrl('/admin/health/reports')|e('html_attr') }}">打开体检报告 · 原件与日常跟踪 ↗</a></p>
            <div class="health-section-heading"><div><h2 id="health-context-title">报告与健康背景</h2><p class="muted">展示全部已保存的报告与限制，不受上方日期范围影响。</p></div><span id="health-context-count" class="source-pill"></span></div>
            <p id="health-context-status" role="status" aria-live="polite">正在读取…</p>
            <div id="health-constraints"></div>
            <div id="health-reports"></div>
            <details id="health-preferences" hidden><summary>生活偏好与补充记录</summary><div></div></details>
        </section>
        <section id="pressure-section" class="health-panel" aria-labelledby="pressure-title">
            <div class="health-section-heading"><div><div class="hub-section-title"><span class="hub-section-icon pressure">{{ icons.icon('pressure') }}</span><h2 id="pressure-title">血压 · 每一次测量</h2></div><p class="muted">保存高压、低压与脉搏，回看长期趋势。</p></div><button type="button" id="pressure-new" class="button primary">＋ 记一次血压</button></div>
            <div id="pressure-status" role="status" class="form-status" aria-live="polite"></div>
            <p id="pressure-range" class="health-data-range" role="status" aria-live="polite">尚未载入血压记录。</p>
            <div id="pressure-summary" class="health-metrics"></div>
            <div id="pressure-chart" class="health-chart" aria-label="血压趋势"></div>
            <details id="pressure-editor" class="health-editor"><summary>录入或修改血压 <span id="pressure-save-state" class="save-state"></span></summary>
                <form id="pressure-form" class="form-grid">
                    <label class="full">测量时间<input type="datetime-local" name="measuredAt" step="1" required><span id="pressure-timezone" class="field-help"></span></label>
                    <label>收缩压（高压 / mmHg）<input type="number" name="systolic" min="1" max="400" step="1" inputmode="numeric" required placeholder="如 120"></label>
                    <label>舒张压（低压 / mmHg）<input type="number" name="diastolic" min="1" max="400" step="1" inputmode="numeric" required placeholder="如 80"></label>
                    <label>脉搏（次/分，可选）<input type="number" name="pulse" min="1" max="400" step="1" inputmode="numeric" placeholder="未记录"></label>
                    <label>测量手臂<select name="arm"><option value="unknown">未记录</option><option value="left">左臂</option><option value="right">右臂</option></select></label>
                    <label>测量体位<select name="posture"><option value="unknown">未记录</option><option value="seated">坐姿</option><option value="standing">站姿</option><option value="lying">卧姿</option></select></label>
                    <label class="full">备注（可选）<textarea name="notes" rows="2" maxlength="2000" placeholder="例如：晨起、运动后，或测量时的感受"></textarea></label>
                    <div class="form-actions full"><button type="submit" class="button primary">保存血压</button><button type="button" id="pressure-cancel" class="button">取消编辑</button></div>
                    <div id="pressure-form-status" class="form-status full" role="status" aria-live="polite"></div>
                    <button type="button" id="pressure-review" class="button full" hidden>读取最新记录，保留我的草稿</button>
                </form>
            </details>
            <details class="health-history"><summary>逐次测量记录</summary><div id="pressure-records"><p class="muted">正在读取…</p></div></details>
            <p class="health-footnote">图表展示原始测量值，不根据单次读数判定疾病，也不会自动改变课表。</p>
        </section>
        <footer class="sh-footer"><span>每一条记录，都是了解自己的起点。</span><a href="{{ relativeUrl('/admin/training/today')|e('html_attr') }}">今日安排</a><a href="{{ relativeUrl('/admin/plans')|e('html_attr') }}">我的计划</a></footer>
    </div>
</div>
{% endblock %}
